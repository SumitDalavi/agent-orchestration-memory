# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: agent-orchestration-memory
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-process Map() storage for conversation threads and memory checkpoints.
#
# TIER 2: LOCAL DEV WITH LIVE REDIS
# - Auto-promotes to persistent Redis cluster when REDIS_URL is provided.
#
# TIER 3: PRODUCTION KUBERNETES DEPLOYMENT
# - Inject credentials via Kubernetes Secrets or Helm values.

# ── Redis / Distributed Memory ───────────────────────────────────────────────
# UNSET (default): In-memory fallback
# SET: Live Redis cluster (e.g., redis://localhost:6379 or rediss://...)
REDIS_URL=

PORT=3000
